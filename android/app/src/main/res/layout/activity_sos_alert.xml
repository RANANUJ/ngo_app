<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0000"
    android:padding="24dp">

    <!-- Warning Icon -->
    <ImageView
        android:id="@+id/warningIcon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:src="@drawable/ic_warning"
        android:contentDescription="Warning Icon" />

    <!-- Alert Title -->
    <TextView
        android:id="@+id/alertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/warningIcon"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:text="🚨 SOS ALERT"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black" />

    <!-- Volunteer Name -->
    <TextView
        android:id="@+id/volunteerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/alertTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:text="John Doe needs help!"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Emergency Type -->
    <TextView
        android:id="@+id/emergencyType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/volunteerName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="Emergency Type"
        android:textColor="#FFCCCC"
        android:textSize="20sp"
        android:gravity="center" />

    <!-- Address -->
    <TextView
        android:id="@+id/address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/emergencyType"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="Location Address"
        android:textColor="#FFCCCC"
        android:textSize="16sp"
        android:gravity="center"
        android:maxLines="3" />

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Acknowledge Button -->
        <Button
            android:id="@+id/btnAcknowledge"
            android:layout_width="280dp"
            android:layout_height="64dp"
            android:text="VIEW DETAILS"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#CC0000"
            android:background="@drawable/btn_white_rounded"
            android:layout_marginBottom="16dp" />

        <!-- Dismiss Button -->
        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:text="DISMISS"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_transparent_rounded" />

    </LinearLayout>

</RelativeLayout>
